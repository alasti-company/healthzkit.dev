{
  "name": "@healthzkit/cockroach",
  "version": "0.0.3",
  "description": "CockroachDB health-check adapter for healthzkit via the PostgreSQL wire protocol (pg).",
  "keywords": [
    "cockroach",
    "cockroachdb",
    "health-check",
    "healthcheck",
    "healthzkit",
    "kubernetes",
    "liveness",
    "pg",
    "postgres",
    "probe",
    "readiness"
  ],
  "homepage": "https://healthzkit.dev/adapter/cockroach",
  "bugs": {
    "url": "https://github.com/alasti-company/healthzkit.dev/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Alasti Company",
    "url": "https://healthzkit.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alasti-company/healthzkit.dev",
    "directory": "packages/cockroach"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./pg": "./dist/pg.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@healthzkit/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@typescript/native-preview": "catalog:",
    "bumpp": "catalog:",
    "healthzkit": "workspace:*",
    "pg": "8.23.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "pg": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": false
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
