{
  "name": "@healthzkit/mongo",
  "version": "0.0.5",
  "description": "MongoDB health-check adapters for healthzkit (mongodb driver and mongoose).",
  "keywords": [
    "health-check",
    "healthcheck",
    "healthzkit",
    "kubernetes",
    "liveness",
    "mongo",
    "mongodb",
    "mongoose",
    "probe",
    "readiness"
  ],
  "homepage": "https://healthzkit.dev/adapter/mongo",
  "bugs": {
    "url": "https://github.com/alasti-company/healthzkit.dev/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Alasti Company",
    "url": "https://healthzkit.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alasti-company/healthzkit.dev",
    "directory": "packages/mongo"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./mongodb": "./dist/mongodb.mjs",
    "./mongoose": "./dist/mongoose.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@healthzkit/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "bumpp": "catalog:",
    "healthzkit": "workspace:*",
    "mongodb": "^7.6.0",
    "mongoose": "^9.9.5",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "mongodb": ">=6.0.0 || >=7.0.0",
    "mongoose": ">= 8.0.0 || >=9.0.0"
  },
  "peerDependenciesMeta": {
    "mongodb": {
      "optional": true
    },
    "mongoose": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}
