{
  "name": "@healthzkit/memcached",
  "version": "0.1.0",
  "description": "Memcached health-check adapters for healthzkit (memcached and memjs).",
  "keywords": [
    "health-check",
    "healthcheck",
    "healthzkit",
    "kubernetes",
    "liveness",
    "memcached",
    "memjs",
    "probe",
    "readiness"
  ],
  "homepage": "https://healthzkit.dev",
  "bugs": {
    "url": "https://github.com/alasti-company/healthzkit.dev/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Alasti Company",
    "url": "https://healthzkit.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alasti-company/healthzkit.dev",
    "directory": "packages/memcached"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./memcached": "./dist/memcached.mjs",
    "./memjs": "./dist/memjs.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@healthzkit/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/memcached": "^2.2.10",
    "@types/memjs": "^1.3.3",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "bumpp": "catalog:",
    "healthzkit": "workspace:*",
    "memcached": "^2.2.2",
    "memjs": "^1.3.2",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "memcached": ">=2.2.2",
    "memjs": ">=1.3.2"
  },
  "peerDependenciesMeta": {
    "memcached": {
      "optional": true
    },
    "memjs": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
