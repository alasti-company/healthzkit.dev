{
  "name": "@healthzkit/minio",
  "version": "0.0.5",
  "description": "MinIO and S3-compatible object-storage health-check adapter for healthzkit.",
  "keywords": [
    "health-check",
    "healthcheck",
    "healthzkit",
    "kubernetes",
    "liveness",
    "minio",
    "probe",
    "readiness",
    "s3"
  ],
  "homepage": "https://healthzkit.dev/adapter/minio",
  "bugs": {
    "url": "https://github.com/alasti-company/healthzkit.dev/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Alasti Company",
    "url": "https://healthzkit.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alasti-company/healthzkit.dev",
    "directory": "packages/minio"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./minio": "./dist/minio.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
