    "express",
    "health-check",
    "healthcheck",
    "healthz",
    "healthzkit",
    "hono",
    "kubernetes",
    "liveness",
    "nextjs",
    "nodejs",
    "probe",
    "readiness"
  ],
  "homepage": "https://healthzkit.dev",
  "bugs": {
    "url": "https://github.com/alasti-company/healthzkit.dev/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Alasti Company",
    "url": "https://healthzkit.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alasti-company/healthzkit.dev",
    "directory": "packages/healthzkit"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
