{
  "name": "@healthzkit/prisma",
  "version": "0.0.6",
  "description": "Prisma health-check adapter for healthzkit (PrismaClient $connect / $queryRawUnsafe).",
  "keywords": [
    "health-check",
    "healthcheck",
    "healthzkit",
    "kubernetes",
    "liveness",
    "orm",
    "prisma",
    "probe",
    "readiness"
  ],
  "homepage": "https://healthzkit.dev/adapter/prisma",
  "bugs": {
    "url": "https://github.com/alasti-company/healthzkit.dev/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Alasti Company",
    "url": "https://healthzkit.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alasti-company/healthzkit.dev",
    "directory": "packages/prisma"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./prisma": "./dist/prisma.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@healthzkit/shared": "workspace:*"
  },
  "devDependencies": {
    "@prisma/client": "7.10.0",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "bumpp": "catalog:",
    "healthzkit": "workspace:*",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@prisma/client": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": false
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
