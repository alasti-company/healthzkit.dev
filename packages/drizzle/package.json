{
  "name": "@healthzkit/drizzle",
  "version": "0.0.6",
  "description": "Drizzle ORM health-check adapter for healthzkit (SELECT 1 via execute or run).",
  "keywords": [
    "drizzle",
    "drizzle-orm",
    "health-check",
    "healthcheck",
    "healthzkit",
    "kubernetes",
    "liveness",
    "orm",
    "probe",
    "readiness"
  ],
  "homepage": "https://healthzkit.dev/adapter/drizzle",
  "bugs": {
    "url": "https://github.com/alasti-company/healthzkit.dev/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Alasti Company",
    "url": "https://healthzkit.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alasti-company/healthzkit.dev",
    "directory": "packages/drizzle"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./drizzle": "./dist/drizzle.mjs",
    "./extract": "./dist/extract.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@healthzkit/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "bumpp": "catalog:",
    "drizzle-orm": "0.45.2",
    "healthzkit": "workspace:*",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.40.0"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": false
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
