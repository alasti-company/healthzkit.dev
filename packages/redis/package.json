{
  "name": "@healthzkit/redis",
  "version": "0.0.5",
  "description": "Redis health-check adapters for healthzkit (ioredis, node-redis, and Upstash).",
  "keywords": [
    "health-check",
    "healthcheck",
    "healthzkit",
    "ioredis",
    "kubernetes",
    "liveness",
    "probe",
    "readiness",
    "redis",
    "upstash"
  ],
  "homepage": "https://healthzkit.dev/adapter/redis",
  "bugs": {
    "url": "https://github.com/alasti-company/healthzkit.dev/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Alasti Company",
    "url": "https://healthzkit.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alasti-company/healthzkit.dev",
    "directory": "packages/redis"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./ioredis": "./dist/ioredis.mjs",
    "./redis": "./dist/redis.mjs",
    "./upstash": "./dist/upstash.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@healthzkit/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@upstash/redis": "^1.38.4",
    "bumpp": "catalog:",
    "healthzkit": "workspace:*",
    "ioredis": "^6.0.0",
    "redis": "^6.2.1",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@upstash/redis": ">=1.0.0",
    "ioredis": ">=5.0.0",
    "redis": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    },
    "redis": {
      "optional": true
    },
