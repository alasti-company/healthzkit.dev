{
  "name": "@healthzkit/dynamo",
  "version": "0.0.5",
  "description": "DynamoDB health-check adapters for healthzkit (AWS SDK v2 and v3).",
  "keywords": [
    "aws",
    "dynamodb",
    "health-check",
    "healthcheck",
    "healthzkit",
    "kubernetes",
    "liveness",
    "probe",
    "readiness"
  ],
  "homepage": "https://healthzkit.dev/adapter/dynamo",
  "bugs": {
    "url": "https://github.com/alasti-company/healthzkit.dev/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Alasti Company",
    "url": "https://healthzkit.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alasti-company/healthzkit.dev",
    "directory": "packages/dynamo"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./v2": "./dist/v2.mjs",
    "./v3": "./dist/v3.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@healthzkit/shared": "workspace:*"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "3.1127.0",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "aws-sdk": "^2.1693.0",
    "bumpp": "catalog:",
    "healthzkit": "workspace:*",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": ">=3.0.0",
    "aws-sdk": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-dynamodb": {
      "optional": true
    },
    "aws-sdk": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}
