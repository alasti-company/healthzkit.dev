    "bumpp": "catalog:",
    "healthzkit": "workspace:*",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "bullmq": ">=5.0.0 <6"
  },
  "peerDependenciesMeta": {
    "bullmq": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
