{
  "name": "@healthzkit/bullmq",
  "version": "0.1.0",
  "description": "BullMQ Queue access and optional backlog health checks for healthzkit.",
  "keywords": [
    "bullmq",
    "health-check",
    "healthzkit",
    "readiness"
  ],
  "homepage": "https://healthzkit.dev/adapter/bullmq",
  "bugs": {
    "url": "https://github.com/alasti-company/healthzkit.dev/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Alasti Company",
    "url": "https://healthzkit.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alasti-company/healthzkit.dev",
    "directory": "packages/bullmq"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./bullmq": "./dist/bullmq.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
