{
  "name": "@healthzkit/node",
  "version": "0.1.0",
  "description": "Node.js memory, event-loop delay, and disk-capacity health adapters for healthzkit.",
  "keywords": [
    "disk",
    "event-loop",
    "healthzkit",
    "memory",
    "node",
    "readiness"
  ],
  "homepage": "https://healthzkit.dev/adapter/node",
  "bugs": {
    "url": "https://github.com/alasti-company/healthzkit.dev/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Alasti Company",
    "url": "https://healthzkit.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alasti-company/healthzkit.dev",
    "directory": "packages/node"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./disk": "./dist/disk.mjs",
    "./event-loop": "./dist/event-loop.mjs",
    "./memory": "./dist/memory.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@healthzkit/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "bumpp": "catalog:",
    "healthzkit": "workspace:*",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
