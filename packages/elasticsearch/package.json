{
  "name": "@healthzkit/elasticsearch",
  "version": "0.0.5",
  "description": "Elasticsearch cluster-health adapter for healthzkit.",
  "keywords": [
    "elasticsearch",
    "health-check",
    "healthcheck",
    "healthzkit",
    "kubernetes",
    "liveness",
    "opensearch",
    "probe",
    "readiness"
  ],
  "homepage": "https://healthzkit.dev/adapter/elasticsearch",
  "bugs": {
    "url": "https://github.com/alasti-company/healthzkit.dev/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Alasti Company",
    "url": "https://healthzkit.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alasti-company/healthzkit.dev",
    "directory": "packages/elasticsearch"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./elasticsearch": "./dist/elasticsearch.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@healthzkit/shared": "workspace:*"
  },
  "devDependencies": {
    "@elastic/elasticsearch": "^9.5.1",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "bumpp": "catalog:",
    "healthzkit": "workspace:*",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@elastic/elasticsearch": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "@elastic/elasticsearch": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
