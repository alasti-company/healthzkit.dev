{
  "name": "@healthzkit/sqs",
  "version": "0.2.0",
  "description": "Amazon SQS health-check adapter for healthzkit (AWS SDK v3).",
  "keywords": [
    "aws",
    "health-check",
    "healthcheck",
    "healthzkit",
    "kubernetes",
    "liveness",
    "probe",
    "readiness",
    "sqs"
  ],
  "homepage": "https://healthzkit.dev/adapter/sqs",
  "bugs": {
    "url": "https://github.com/alasti-company/healthzkit.dev/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Alasti Company",
    "url": "https://healthzkit.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alasti-company/healthzkit.dev",
    "directory": "packages/sqs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./v3": "./dist/v3.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@healthzkit/shared": "workspace:*"
  },
  "devDependencies": {
    "@aws-sdk/client-sqs": "^3.1161.0",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "bumpp": "catalog:",
    "healthzkit": "workspace:*",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@aws-sdk/client-sqs": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-sqs": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
