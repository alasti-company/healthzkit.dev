{
  "name": "@healthzkit/root",
  "version": "0.0.1",
  "private": true,
  "description": "Root healthzkit repository",
  "type": "module",
  "scripts": {
    "ready": "vp fmt && vp lint && vp run test && vp run build",
    "test": "vp run -r test",
    "build": "vp run -r build",
    "dev": "vp run -r dev",
    "clean": "vpx rimraf \"**/node_modules\" --glob",
    "prepare": "vp config",
    "publish": "vp run -r build && vpx changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.33.3"
}
