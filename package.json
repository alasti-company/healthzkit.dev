{
  "name": "@healthzkit/root",
  "version": "0.0.1",
  "private": true,
  "description": "Root healthzkit repository",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alasti-company/healthzkit.dev"
  },
  "type": "module",
  "scripts": {
    "ready": "vp fmt && vp lint && vp run test && vp run build",
    "test": "vp run -r test",
    "test:packages": "node tools/package-smoke.mjs",
    "test:integration": "node tools/integration/run.mjs",
    "build": "vp run -r build",
    "dev": "vp run -r dev",
    "clean": "vpx rimraf \"**/node_modules\" --glob",
    "prepare": "vp config",
    "version-packages": "vpx changeset version && vp fmt",
    "publish": "vp run -r build && vpx changeset publish",
    "audit:security": "node tools/security-audit.mjs",
    "test:security": "vp test --run tools/security-audit.test.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "node-gyp": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.3.4"
}
