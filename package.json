{
  "name": "@healthzkit/root",
  "version": "0.0.1",
  "private": true,
  "description": "Framework-agnostic Kubernetes liveness and readiness probes for Node.js — core kit plus official database, queue, and storage adapters.",
  "keywords": [
    "health-check",
    "healthcheck",
    "healthzkit",
    "kubernetes",
    "liveness",
    "monorepo",
    "probe",
    "readiness"
  ],
  "homepage": "https://healthzkit.dev",
  "bugs": {
    "url": "https://github.com/alasti-company/healthzkit.dev/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Alasti Company",
    "url": "https://healthzkit.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alasti-company/healthzkit.dev"
  },
  "type": "module",
  "scripts": {
    "ready": "vp fmt && vp lint && vp run test && vp run build",
    "test": "vp run -r test",
    "build": "vp run -r build",
    "dev": "vp run -r dev",
    "clean": "vpx rimraf \"**/node_modules\" --glob",
    "prepare": "vp config",
    "publish": "vp run -r build && vpx changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "node-gyp": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.3.4"
}
